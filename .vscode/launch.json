{
    "version":  "0.2.0",
    "configurations":  [
                           {
                               "name":  "Pico Debug (Zephyr)",
                               "cwd":  "${workspaceFolder}",
                               "executable":  "${workspaceFolder}/build/zephyr/zephyr.elf",
                               "request":  "launch",
                               "type":  "cortex-debug",
                               "servertype":  "openocd",
                               "serverpath":  "${command:raspberry-pi-pico.getOpenOCDRoot}/openocd",
                               "searchDir":  [
                                                 "${command:raspberry-pi-pico.getOpenOCDRoot}/scripts"
                                             ],
                               "toolchainPrefix":  "arm-zephyr-eabi",
                               "armToolchainPath":  "${command:raspberry-pi-pico.getZephyrSDKPath}/gnu/arm-zephyr-eabi/bin",
                               "device":  "RP2350",
                               "svdFile":  "${userHome}/.pico-sdk/sdk/2.3.1/src/rp2350/hardware_regs/RP2350.svd",
                               "configFiles":  [
                                                   "interface/cmsis-dap.cfg",
                                                   "target/rp2350.cfg"
                                               ],
                               "openOCDPreConfigLaunchCommands":  [
                                                                      "set USE_CORE cm0"
                                                                  ],
                               "showDevDebugOutput":  "raw",
                               "runToEntryPoint":  "main",
                               "openOCDLaunchCommands":  [
                                                             "adapter speed 5000"
                                                         ],
                               "rtos":  "Zephyr",
                               "preLaunchTask":  "Compile Project"
                           },
                           {
                               "name":  "WiFi Debug (Pico 2 W)",
                               "cwd":  "${workspaceFolder}",
                               "executable":  "${workspaceFolder}/build/zephyr/zephyr.elf",
                               "request":  "launch",
                               "type":  "cortex-debug",
                               "servertype":  "openocd",
                               "serverpath":  "${command:raspberry-pi-pico.getOpenOCDRoot}/openocd",
                               "searchDir":  [
                                                 "${command:raspberry-pi-pico.getOpenOCDRoot}/scripts"
                                             ],
                               "toolchainPrefix":  "arm-zephyr-eabi",
                               "armToolchainPath":  "${command:raspberry-pi-pico.getZephyrSDKPath}/gnu/arm-zephyr-eabi/bin",
                               "device":  "RP2350",
                               "svdFile":  "${userHome}/.pico-sdk/sdk/2.3.1/src/rp2350/hardware_regs/RP2350.svd",
                               "configFiles":  [
                                                   "interface/cmsis-dap.cfg",
                                                   "target/rp2350.cfg"
                                               ],
                               "openOCDPreConfigLaunchCommands":  [
                                                                      "set USE_CORE cm0"
                                                                  ],
                               "showDevDebugOutput":  "raw",
                               "runToEntryPoint":  "main",
                               "openOCDLaunchCommands":  [
                                                             "adapter speed 5000"
                                                         ],
                               "rtos":  "Zephyr",
                               "preLaunchTask":  "Build WiFi"
                           }
                       ]
}
